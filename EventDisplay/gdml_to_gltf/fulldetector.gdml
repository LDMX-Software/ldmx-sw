                  <position name="side_hcal_scintY_4_2_12_Pos" unit="mm"
                            x="(-(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            y="-1*ecal_side_dy - 1*( 1600-1800 )/2."
