              -->
              <physvol name="side_hcal_absoY1_3_4_5_Physvol">
                <volumeref ref="side_hcal_absoY_4_Volume"/>
                <position name="side_hcal_absoY1_3_4_5_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick/2.0)) + -1*( (5-1)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
