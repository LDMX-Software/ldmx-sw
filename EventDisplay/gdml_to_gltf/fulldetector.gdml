                            y="(-(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (5)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (2-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_2_4_3_Physvol"
