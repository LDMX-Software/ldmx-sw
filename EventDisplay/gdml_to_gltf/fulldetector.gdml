                            z="-back_hcal_dz/2.0"/>
                </physvol>
              <!--</loop>-->

              <!--
            Absorber plates oriented in x
            x (start): same x as in first absorber
            y (start): same y as in first absorber but with extra y for even layer
              -->
              <physvol name="side_hcal_absoX2_1_3_Physvol">
                <volumeref ref="side_hcal_absoX_3_Volume"/>
                <position name="side_hcal_absoX2_1_3_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)) + -1*( 1400-1800 )/2."
                          y="(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0) - -1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*7 )"
                          z="-back_hcal_dz/2.0"/>
              </physvol>

              <!--
            Long strips oriented in x
            x (start): ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick * -1 (to be centered)
            y (start): same as scintillator oriented in z but with extra y for even layer
            z (start): -back_hcal_dz/2.0 - side_hcal_dz/2.0
                                   + hcal_scintWidth/2.0 ( so that is centered)
              -->
              <!--<loop for="strip" from="1" to="side_hcal_numScintXY" step="1">-->
                <physvol name="side_hcal_scintX_1_3_1_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (3+1+2*7)*256 + (1-1)">
