                            y="(-(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (9-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_2_2_10_Physvol"
                         copynumber="1*256*256*256 + (section)*256*256 + (1+1+2*4)*256 + (10-1)">
