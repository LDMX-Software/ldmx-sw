        <volume name="W_cooling_volume_16">
            <materialref ref="G4_W0x270bda0"/>
            <solidref ref="W_cooling_absorber_16"/>
            <!--<auxiliary auxtype="VisAttributes" auxvalue="BlueSolid"/>-->
        </volume>
        <!--</loop>-->

        <!--
        All of the physical volumes will be included as a child volume
        of the 'em_calorimeters' logical volume.

        The material layers that have a single shape per ECal layer
        (e.g. carbon cooling plane, tungsten absorber, motherboard)
        will be included in the CENTER STACK section while subsequent
        sections for the ring of hexagons forming the "petals" of the
        ECal flower will be put in after.

        Each "bilayer sandwich" of the ECal is formed from the following
        stack (in order of increasing z position). The only part that is
        changing between different sections of the ECal is the thickness
        of the absorber.

                            Front Absorber
                            Front Tolerance Gap
                            Motherboard
                            Motherboard Gap
                        - - Hex PCB
                Flower    |   Thin Glue
                (even)    |   Sensitive Silicon
                        |   Thick Glue
                        - - Carbon Base Plate
                            Cooling Absorber
                            Carbon Cooling Plane
                            Cooling Absorber
                        - - Carbon Base Plate
                        |   Thick Glue
                Flower    |   Sensitive Silicon
                (odd)     |   Thin Glue
                        - - Hex PCB
                            Motherboard Gap
                            Motherboard
                            Back Tolerance Gap
        -->
    <volume name="em_calorimeters">
      <materialref ref="G4_AIR0x271da60"/>
      <solidref ref="ECal_box"/>

      <!--
        the support box is not symmetric in the vertical direction but
        we center it at half its max y-coordinate because why not

        Instead we could center on the central cavern with
          y="-12.7-(520.7-12.7)/2."
      -->
      <physvol>
        <!--<file name="ecal_support_box.gdml"/>-->
        <volumeref ref="support_box"/>
        <positionref ref="support_box_pos"/>
      </physvol>

      <!--
        PRE-SHOWER LAYER

        The pre-shower bilayer is designed in the same way as all of the other layers _except_
        it has omitted all of the absorber layers.
      -->
      <physvol>
        <volumeref ref="PCB_motherboard_volume"/>
        <position name="PCB_PS_motherboard_physvol0_pos" unit="mm" x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + MotherBoardAssembly_dz/2."/>
      </physvol>


      <physvol>
        <volumeref ref="PCB_volume"/>
        <position name="PCB_volume_rel_to_hexaboard"
          x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap"/>
      </physvol>
      <physvol>
        <volumeref ref="Glue_volume"/>
        <position name="Glue_volume_rel_to_hexaboard"
          x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz"/>
      </physvol>
      <physvol copynumber="7*0 + 0">
        <volumeref ref="Si_volume"/>
        <position name="Si_volume_rel_to_hexaboard"
          x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz"/>
      </physvol>
      <physvol>
        <volumeref ref="GlueThick_volume"/>
        <position name="GlueThick_volume_rel_to_hexaboard"
          x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz"/>
      </physvol>
      <physvol>
        <volumeref ref="CarbonBasePlate_volume"/>
        <position name="CarbonBasePlate_volume_rel_to_hexaboard"
          x="0" y="-support_box_shift"
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz + GlueThick_dz"/>
      </physvol>

      <!--<loop for="module" from="1" to="6" step="1">-->
        <physvol>
          <volumeref ref="PCB_volume"/>
          <position name="PCB_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((1-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((1-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap"/>
        </physvol>
        <physvol>
          <volumeref ref="Glue_volume"/>
          <position name="Glue_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((1-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((1-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz"/>
        </physvol>
        <physvol copynumber="7*0 + 1">
          <volumeref ref="Si_volume"/>
          <position name="Si_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((1-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((1-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="GlueThick_volume"/>
          <position name="GlueThick_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((1-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((1-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="CarbonBasePlate_volume"/>
          <position name="CarbonBasePlate_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((1-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((1-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz + GlueThick_dz"/>
        </physvol>

        <physvol>
          <volumeref ref="PCB_volume"/>
          <position name="PCB_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((2-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((2-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap"/>
        </physvol>
        <physvol>
          <volumeref ref="Glue_volume"/>
          <position name="Glue_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((2-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((2-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz"/>
        </physvol>
        <physvol copynumber="7*0 + 2">
          <volumeref ref="Si_volume"/>
          <position name="Si_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((2-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((2-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="GlueThick_volume"/>
          <position name="GlueThick_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((2-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((2-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="CarbonBasePlate_volume"/>
          <position name="CarbonBasePlate_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((2-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((2-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz + GlueThick_dz"/>
        </physvol>

        <physvol>
          <volumeref ref="PCB_volume"/>
          <position name="PCB_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((3-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((3-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap"/>
        </physvol>
        <physvol>
          <volumeref ref="Glue_volume"/>
          <position name="Glue_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((3-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((3-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz"/>
        </physvol>
        <physvol copynumber="7*0 + 3">
          <volumeref ref="Si_volume"/>
          <position name="Si_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((3-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((3-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="GlueThick_volume"/>
          <position name="GlueThick_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((3-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((3-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="CarbonBasePlate_volume"/>
          <position name="CarbonBasePlate_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((3-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((3-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz + GlueThick_dz"/>
        </physvol>

        <physvol>
          <volumeref ref="PCB_volume"/>
          <position name="PCB_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap"/>
        </physvol>
        <physvol>
          <volumeref ref="Glue_volume"/>
          <position name="Glue_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz"/>
        </physvol>
        <physvol copynumber="7*0 + 4">
          <volumeref ref="Si_volume"/>
          <position name="Si_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="GlueThick_volume"/>
          <position name="GlueThick_volume_rel_to_hexaboard"
            x="(2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
            y="- support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
            z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + PCB_dz + Glue_dz + Si_dz"/>
        </physvol>
        <physvol>
          <volumeref ref="CarbonBasePlate_volume"/>
