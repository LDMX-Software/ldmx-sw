                <volumeref ref="side_hcal_absoX_2_Volume"/>
                <position name="side_hcal_absoX1_1_2_5_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)) + -1*( 1600-1800 )/2."
                          y="(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0) - -1*( (5-1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                          z="-back_hcal_dz/2.0"/>
              </physvol>

              <!--
