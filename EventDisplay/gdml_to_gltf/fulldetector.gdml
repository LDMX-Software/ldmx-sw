  <solids>
    <!-- - - - - - - - - HCal solids - - - - - - - -  -->
    <box lunit="mm" name="back_hcal_absoBox" x="back_hcal_dx" y="back_hcal_dy" z="back_hcal_absoThick"/>
    <box lunit="mm" name="back_hcal_scintXBox" x="back_hcal_dx" y="hcal_scintWidth" z="hcal_scintThick"/>
    <box lunit="mm" name="back_hcal_scintYBox" x="hcal_scintWidth" y="back_hcal_dy" z="hcal_scintThick"/>

    <!--<loop for="module" from="1" to="side_hcal_numModules" step="1">-->
      <box name="side_hcal_absoX_1_Box" lunit="mm"
     x="1800" y="side_hcal_absoThick" z="side_hcal_dz"/>
      <box name="side_hcal_absoY_1_Box" lunit="mm"
           x="side_hcal_absoThick" y="1800" z="side_hcal_dz"/> 
      <box name="side_hcal_scintX_1_Box" lunit="mm"
     x="1800" y="hcal_scintThick" z="hcal_scintWidth"/>
      <box name="side_hcal_scintY_1_Box" lunit="mm"
           x="hcal_scintThick" y="1800" z="hcal_scintWidth"/>

      <box name="side_hcal_absoX_2_Box" lunit="mm"
     x="1600" y="side_hcal_absoThick" z="side_hcal_dz"/>
      <box name="side_hcal_absoY_2_Box" lunit="mm"
           x="side_hcal_absoThick" y="1600" z="side_hcal_dz"/> 
      <box name="side_hcal_scintX_2_Box" lunit="mm"
     x="1600" y="hcal_scintThick" z="hcal_scintWidth"/>
      <box name="side_hcal_scintY_2_Box" lunit="mm"
           x="hcal_scintThick" y="1600" z="hcal_scintWidth"/>

      <box name="side_hcal_absoX_3_Box" lunit="mm"
     x="1400" y="side_hcal_absoThick" z="side_hcal_dz"/>
      <box name="side_hcal_absoY_3_Box" lunit="mm"
           x="side_hcal_absoThick" y="1400" z="side_hcal_dz"/> 
      <box name="side_hcal_scintX_3_Box" lunit="mm"
     x="1400" y="hcal_scintThick" z="hcal_scintWidth"/>
      <box name="side_hcal_scintY_3_Box" lunit="mm"
           x="hcal_scintThick" y="1400" z="hcal_scintWidth"/>
      
      <box name="side_hcal_absoX_4_Box" lunit="mm"
     x="1200" y="side_hcal_absoThick" z="side_hcal_dz"/>
      <box name="side_hcal_absoY_4_Box" lunit="mm"
           x="side_hcal_absoThick" y="1200" z="side_hcal_dz"/> 
      <box name="side_hcal_scintX_4_Box" lunit="mm"
     x="1200" y="hcal_scintThick" z="hcal_scintWidth"/>
      <box name="side_hcal_scintY_4_Box" lunit="mm"
           x="hcal_scintThick" y="1200" z="hcal_scintWidth"/>
    <!--</loop>-->

    <box lunit="mm" name="side_hcal_scintZXBox" x="hcal_scintWidth" y="hcal_scintThick" z="side_hcal_dz"/>    
    <box lunit="mm" name="side_hcal_scintZYBox" x="hcal_scintThick" y="hcal_scintWidth" z="side_hcal_dz"/>

    <!-- - - - - - - - - Parent Volumes - - - - - - - -->     
    <box lunit="mm" name="all_hcal_Box" x="hcal_envelope_dx" y="hcal_envelope_dy" z="hcal_dz"/>
    <box lunit="mm" name="ecal_Box" x="ecal_side_dx" y="ecal_side_dy" z="side_hcal_dz"/>
    <!-- The second solid is placed with given position, in the coordinates of the first solid -->
    <subtraction name="hadron_calorimeter_Box">
      <first ref="all_hcal_Box"/>
      <second ref="ecal_Box"/>
      <position name="hadron_calorimeter_parent_Box_pos" unit="mm" x="0." y="0." z="-back_hcal_dz/2.0"/>    
    </subtraction>

