                  <position name="side_hcal_scintX_1_3_1_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)*-1 + -1*( 1400-1800 )/2."
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*7 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (1-1)*hcal_scintWidth"/>
                </physvol>

