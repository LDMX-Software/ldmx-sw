                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (4-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_2_5_Physvol"
