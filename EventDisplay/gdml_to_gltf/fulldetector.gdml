                </physvol>
              <!--</loop>-->


              <!--
            Absorber plates oriented in y
            x (start): ecal_side_dx/2.0 + (hcal_airThick+side_hcal_absoThick/2.0)
            y (start): ecal_side_dy ( if its ecal_side_dy/2.0, the absorber plates are not centered, use ecal_side_dy to get them centered)
              -->
              <physvol name="side_hcal_absoY1_3_2_5_Physvol">
                <volumeref ref="side_hcal_absoY_2_Volume"/>
                <position name="side_hcal_absoY1_3_2_5_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick/2.0)) + -1*( (5-1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                          y="(-(ecal_side_dy)) + -1*( 1600-1800 )/2."
                          z="-back_hcal_dz/2.0"/>
              </physvol >

              <!--
            Short strips oriented in z
            x (start): ecal_side_dx/2.0 + (2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)
            y (start): ecal_side_dy/2.0 - hcal_scintWidth/2.0
              -->
              <!--<loop for="strip" from="1" to="side_hcal_numScintZ_2_" step="1">-->
                <physvol name="side_hcal_scintZY_3_2_1_Physvol"
