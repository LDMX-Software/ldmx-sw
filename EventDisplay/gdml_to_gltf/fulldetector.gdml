                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_4_7_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(7-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*9)"
