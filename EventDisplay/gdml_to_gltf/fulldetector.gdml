                            y="-1*ecal_side_dy - 1*( 1600-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (10-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintY_4_2_11_Physvol"
