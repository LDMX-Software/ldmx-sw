                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (5)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (5-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_2_6_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (5+1+2*4)*256 + (6-1)">
                  <volumeref ref="side_hcal_scintX_2_Volume"/>
                  <position name="side_hcal_scintX_1_2_6_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)*-1 + -1*( 1600-1800 )/2."
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (5)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (6-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_2_7_Physvol"
