                <physvol name="side_hcal_scintX_2_2_1_Physvol"
                         copynumber="1*256*256*256 + (section)*256*256 + (3+1+2*4)*256 + (1-1)">
                  <volumeref ref="side_hcal_scintX_2_Volume"/>
                  <position name="side_hcal_scintX_2_2_1_Pos" unit="mm"
                            x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick))*-1 + 1*( 1600-1800 )/2."
                            y="(-(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
