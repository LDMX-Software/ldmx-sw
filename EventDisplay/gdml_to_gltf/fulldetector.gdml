                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (5)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
                            y="--1*ecal_side_dy - -1*( 1200-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (12-1)*hcal_scintWidth"/>
                </physvol>
              <!--</loop>-->
            <!--</loop> Y-oriented Side Hcal Layers -->
          <!--</loop> Y-oriented Side Hcal Modules -->

          <!--<loop for="module" from="1" to="side_hcal_numModules" step="1">-->
            <!--<loop for="layer" from="1" to="side_hcal_numLayers_1_*2" step="2">-->

              <!--
            Absorber plates oriented in y
            x (start): ecal_side_dx/2.0 + (hcal_airThick+side_hcal_absoThick/2.0)
            y (start): ecal_side_dy ( if its ecal_side_dy/2.0, the absorber plates are not centered, use ecal_side_dy to get them centered)
              -->
              <physvol name="side_hcal_absoY1_4_1_1_Physvol">
                <volumeref ref="side_hcal_absoY_1_Volume"/>
                <position name="side_hcal_absoY1_4_1_1_Pos" unit="mm"
                          x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick/2.0) + 1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                          y="((ecal_side_dy)) + 1*( 1800-1800 )/2."
                          z="-back_hcal_dz/2.0"/>
              </physvol >

              <!--
            Short strips oriented in z
            x (start): ecal_side_dx/2.0 + (2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)
