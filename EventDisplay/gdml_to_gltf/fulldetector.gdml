                <position name="side_hcal_absoX2_2_4_Pos" unit="mm"
                          x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick) + 1*( 1200-1800 )/2."
                          y="(-(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0)) - 1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
                          z="-back_hcal_dz/2.0"/>
              </physvol>

