          <!--</loop>-->
        <!--</loop>  Back Hcal layer  -->

        <!-- SIDE HCAL layers oriented in x -->
        <!--
            Extra lenghts per module: ( side_hcal_length[module]-1800 )/2.
            Extra x/y per layer:
            (odd): (layer-1)*side_hcal_layerThick + 2*side_hcal_layerThick*side_hcal_numPrevLayers[module]
            (even): (layer)*side_hcal_layerThick + 2*side_hcal_layerThick*side_hcal_numPrevLayers[module]
            Extra x/y for strips oriented in z:
            hcal_scintWidth*(strip)
        -->
        <!--<loop for="section" from="1" to="2" step="1">-->
          <!--<loop for="module" from="1" to="side_hcal_numModules" step="1">-->
            <!--<loop for="layer" from="1" to="4*2" step="2">-->
              <!--
            Absorber plates oriented in x
            x (start): ecal_side_dx/2.0
                       +hcal_airThick+side_hcal_absoThick ( to account for absorber in y from the other sections )
            y (start): ecal_side_dy/2.0
                       +hcal_airThick+side_hcal_absoThick/2.0 ( to account for air and so that absorber is centered)
              -->
              <physvol name="side_hcal_absoX1_1_1_1_Physvol">
                <volumeref ref="side_hcal_absoX_1_Volume"/>
                <position name="side_hcal_absoX1_1_1_1_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)) + -1*( 1800-1800 )/2."
                          y="(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                          z="-back_hcal_dz/2.0"/>
              </physvol>

              <!--
            Short strips oriented in z
            x (start): ecal_side_dx/2.0 (similar to absorber but with different sign)
                       -hcal_scintWidth/2.0 ( so that scintillator is centered)
            y (start): ecal_side_dy/2.0
                       +2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0 ( to account for air,absober and so that scintillator is centered)
              -->
              <!--<loop for="strip" from="1" to="36" step="1">-->
                <physvol name="side_hcal_scintZX_1_1_1_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+2*0)*256 + (1-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_1_1_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(1-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_1_1_2_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+2*0)*256 + (2-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_1_2_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(2-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_1_1_3_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+2*0)*256 + (3-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_1_3_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(3-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_1_1_4_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+2*0)*256 + (4-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_1_4_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(4-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
