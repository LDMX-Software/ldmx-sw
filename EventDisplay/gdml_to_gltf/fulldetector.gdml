          </physvol>
          <physvol copynumber="7*(2*16 + 1) + 4">
            <volumeref ref="Si_volume"/>
            <position name="Si_volume_odd_pos_16_4"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz" />
          </physvol>
          <physvol>
            <volumeref ref="Glue_volume"/>
            <position name="Glue_volume_odd_pos_16_4"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz" />
          </physvol>
          <physvol>
            <volumeref ref="PCB_volume"/>
            <position name="PCB_volume_odd_pos_16_4"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((4-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((4-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz + Glue_dz"/>
          </physvol>

          <physvol>
            <volumeref ref="CarbonBasePlate_volume"/>
            <position name="CarbonBasePlate_volume_odd_16_5"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((5-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((5-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5" />
          </physvol>
          <physvol>
            <volumeref ref="GlueThick_volume"/>
            <position name="GlueThick_volume_odd_16_5"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((5-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((5-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz"/>
          </physvol>
          <physvol copynumber="7*(2*16 + 1) + 5">
            <volumeref ref="Si_volume"/>
            <position name="Si_volume_odd_pos_16_5"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((5-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((5-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz" />
          </physvol>
          <physvol>
            <volumeref ref="Glue_volume"/>
            <position name="Glue_volume_odd_pos_16_5"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((5-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((5-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz" />
          </physvol>
          <physvol>
            <volumeref ref="PCB_volume"/>
            <position name="PCB_volume_odd_pos_16_5"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((5-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((5-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz + Glue_dz"/>
          </physvol>

          <physvol>
            <volumeref ref="CarbonBasePlate_volume"/>
            <position name="CarbonBasePlate_volume_odd_16_6"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((6-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((6-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5" />
          </physvol>
          <physvol>
            <volumeref ref="GlueThick_volume"/>
            <position name="GlueThick_volume_odd_16_6"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((6-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((6-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz"/>
          </physvol>
          <physvol copynumber="7*(2*16 + 1) + 6">
            <volumeref ref="Si_volume"/>
            <position name="Si_volume_odd_pos_16_6"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((6-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((6-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz" />
          </physvol>
          <physvol>
            <volumeref ref="Glue_volume"/>
            <position name="Glue_volume_odd_pos_16_6"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((6-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((6-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz" />
          </physvol>
          <physvol>
            <volumeref ref="PCB_volume"/>
            <position name="PCB_volume_odd_pos_16_6"
              x="shift_x + (2.*Hex_radius + hexagon_gap) * cos((6-1)*pi/3)" 
              y="shift_y - support_box_shift - (2.*Hex_radius + hexagon_gap) * sin((6-1)*pi/3)" 
              z="bilayer_start + sampling_section_offset
                + bilayer_noabsorber_thickness*16
                + 141.9
                + BackTolerance
                + 7.0 + FrontTolerance 
                + PCB_dz + PCB_Motherboard_Gap + Flower_dz
                + 3.5 + CarbonCoolingPlane_dz + 3.5
                + CarbonBasePlate_dz + GlueThick_dz + Si_dz + Glue_dz"/>
          </physvol>
        <!--</loop>-->
  
        <physvol>
          <volumeref ref="PCB_motherboard_volume"/>
          <rotationref ref="flip"/>
          <position name="PCB_motherboard_pos1_16" unit="mm" 
            x="shift_x" y="shift_y - support_box_shift" 
            z="bilayer_start + sampling_section_offset
              + bilayer_noabsorber_thickness*16
              + 127.9
              + BackTolerance
              + 7.0 + FrontTolerance 
              + PCB_dz + PCB_Motherboard_Gap + Flower_dz
              + 3.5 + CarbonCoolingPlane_dz + 3.5 
              + Flower_dz + PCB_Motherboard_Gap +PCB_dz - MotherBoardAssembly_dz/2."/>
        </physvol>
      <!--</loop>-->
      <auxiliary auxtype="Region" auxvalue="CalorimeterRegion"/>
          <!--<auxiliary auxtype="VisAttributes" auxvalue="GrayWireFrame"/>-->
      <auxiliary auxtype="DetElem" auxvalue="Ecal"/>
    </volume>

    <!--magnet_structure-->
    <volume name="coil_1_vol" >
            <materialref ref="Cu" />
            <solidref ref="coil_1" />
        </volume>
        <volume name="coil_2_vol" >
            <materialref ref="Cu" />
            <solidref ref="coil_2" />
        </volume>
        <volume name="shim_right" >
            <materialref ref="Fe" />
            <solidref ref="shim_right_box" />
        </volume>
        <volume name="shim_left" >
            <materialref ref="Fe" />
            <solidref ref="shim_left_box" />
        </volume>
        <volume name="corner_iron_block_top_left" >
            <materialref ref="Fe" />
            <solidref ref="corner_iron_block_top_left_box" />
        </volume>
        <volume name="corner_iron_block_top_right" >
            <materialref ref="Fe" />
            <solidref ref="corner_iron_block_top_right_box" />
        </volume>
        <volume name="corner_iron_block_bot_left" >
            <materialref ref="Fe" />
            <solidref ref="corner_iron_block_bot_left_box" />
        </volume>
        <volume name="corner_iron_block_bot_right" >
            <materialref ref="Fe" />
            <solidref ref="corner_iron_block_bot_right_box" />
        </volume>
        <volume name="center_iron_block_top" >
            <materialref ref="Fe" />
            <solidref ref="center_iron_block_top_box" />
        </volume>
        <volume name="center_iron_block_bot" >
            <materialref ref="Fe" />
            <solidref ref="center_iron_block_bot_box" />
        </volume>
        <volume name="ldmx_magnet" >
            <materialref ref="Vacuum" />
            <solidref ref="magnet_box_with_gap" />
            <physvol>
                <volumeref ref="coil_1_vol" />
                <positionref ref="top_coil_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="coil_2_vol" />
                <positionref ref="bot_coil_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="shim_right" />
                <positionref ref="shim_right_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="shim_left" />
                <positionref ref="shim_left_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="corner_iron_block_top_left" />
                <positionref ref="corner_iron_block_top_left_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="corner_iron_block_top_right" />
                <positionref ref="corner_iron_block_top_right_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="corner_iron_block_bot_left" />
                <positionref ref="corner_iron_block_bot_left_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="corner_iron_block_bot_right" />
                <positionref ref="corner_iron_block_bot_right_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="center_iron_block_top" />
                <positionref ref="center_iron_block_top_pos" />
                <rotationref ref="identity" />
            </physvol>
            <physvol>
                <volumeref ref="center_iron_block_bot" />
                <positionref ref="center_iron_block_bot_pos" />
                <rotationref ref="identity" />
            </physvol>
            <auxiliary auxtype="Region" auxvalue="MagnetRegion"/>
            <auxiliary auxtype="VisAttributes" auxvalue="MagnetVis"/>
        </volume>

        <!--tagger_structure-->
        <!-- define tagger sensor as a active box inside an inactive box -->  
    <volume name="Tagger_active_Sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="tagger_active_sensor_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleNoDau"/>
    </volume>
    <volume name="tagger_sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="tagger_sensor_box"/>
      <physvol name="tagger_active_sensor">
      <volumeref ref="Tagger_active_Sensor_vol"/>
      <position name="tagger_active_sensor_pos" unit="mm" x="0.0" y="0.0" z="0.0"/>
      </physvol>
    </volume>
    <volume name="tagger">
      <materialref ref="Air"/>
      <solidref ref="tagger_box"/>
      <!--<loop for="i" from="1" to="7" step="1">-->
      <!-- Axial Layers -->
      <physvol copynumber="10">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-0.006" y="0.0" 
            z="297"/>  
      </physvol>
      <physvol copynumber="30">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-0.681" y="0.0" 
            z="197"/>  
      </physvol>
      <physvol copynumber="50">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-2.481" y="0.0" 
            z="97"/>  
      </physvol>
      <physvol copynumber="70">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-5.407" y="0.0" 
            z="-3"/>  
      </physvol>
      <physvol copynumber="90">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-9.461" y="0.0" 
            z="-103"/>  
      </physvol>
      <physvol copynumber="110">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-14.643" y="0.0" 
            z="-203"/>  
      </physvol>
      <physvol copynumber="130">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_axial_pos" unit="mm" x="-20.955" y="0.0" 
            z="-303"/>  
      </physvol>
      <!-- Stereo Layers --> 
      <physvol copynumber="20">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-0.006" y="0.0" 
            z="303" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="stereo_angle" />
      </physvol>
      <physvol copynumber="40">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-0.681" y="0.0" 
            z="203" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="-stereo_angle" />
      </physvol>
      <physvol copynumber="60">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-2.481" y="0.0" 
            z="103" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="stereo_angle" />
      </physvol>
      <physvol copynumber="80">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-5.407" y="0.0" 
            z="3" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="-stereo_angle" />
      </physvol>
      <physvol copynumber="100">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-9.461" y="0.0" 
            z="-97" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="stereo_angle" />
      </physvol>
      <physvol copynumber="120">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-14.643" y="0.0" 
            z="-197" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="-stereo_angle" />
      </physvol>
      <physvol copynumber="140">
        <volumeref ref="tagger_sensor_vol" />
        <position name="tagger_stereo_pos" unit="mm" x="-20.955" y="0.0" 
            z="-297" />
        <rotation name="tagger_stereo_rot" unit="deg" x="0.0" y="0.0" z="stereo_angle" />
      </physvol>
      <!--</loop>-->
      <auxiliary auxtype="Region" auxvalue="tagger"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleShowDau"/>
      <auxiliary auxtype="DetElem" auxvalue="tagger"/>
    </volume>

    <!-- Define a recoil sensor as a active box inside an inactive box -->  
    <volume name="Recoil_l14_active_Sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l14_active_sensor_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleNoDau"/>
    </volume>
    <volume name="recoil_l14_sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l14_sensor_box"/>
      <physvol name="recoil_l14_active_sensor">
        <volumeref ref="Recoil_l14_active_Sensor_vol"/>
        <position name="recoil_l14_active_sensor_pos" unit="mm" x="0.0" y="0.0" z="0.0"/>
      </physvol>
    </volume>
    <volume name="Recoil_l56_active_Sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l56_active_sensor_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleNoDau"/>
    </volume>
    <volume name="recoil_l56_sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l56_sensor_box"/>
      <physvol name="recoil_l56_active_sensor">
        <volumeref ref="Recoil_l56_active_Sensor_vol"/>
        <position name="recoil_l56_active_sensor_pos" unit="mm" x="0.0" y="0.0" z="0.0"/>
      </physvol>
    </volume>

    <volume name="recoil">
      <materialref ref="Air"/>
      <solidref ref="recoil_box"/>
      <!--<loop for="i" from="1" to="4" step="1"> -->
        <!-- Axial sensors --> 
        <physvol copynumber="20*1-10"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_axial_pos" unit="mm" x="0.0" y="0.0" 
                    z="-86 - recoil_l14_sensor_sep" /> 
        </physvol>
        <!-- Stereo sensors -->
        <physvol copynumber="20*1"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_stereo_pos" unit="mm" x="0.0" y="0.0" 
                    z="-86 + recoil_l14_sensor_sep" /> 
          <rotation name="recoil_l14_stereo_rot" unit="deg" x="0" y="0" z="stereo_angle"/>
        </physvol>

        <!-- Axial sensors --> 
        <physvol copynumber="20*2-10"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_axial_pos" unit="mm" x="0.0" y="0.0" 
                    z="-71 - recoil_l14_sensor_sep" /> 
        </physvol>
        <!-- Stereo sensors -->
        <physvol copynumber="20*2"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_stereo_pos" unit="mm" x="0.0" y="0.0" 
                    z="-71 + recoil_l14_sensor_sep" /> 
          <rotation name="recoil_l14_stereo_rot" unit="deg" x="0" y="0" z="-stereo_angle"/>
        </physvol>

        <!-- Axial sensors --> 
        <physvol copynumber="20*3-10"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_axial_pos" unit="mm" x="0.0" y="0.0" 
                    z="-56 - recoil_l14_sensor_sep" /> 
        </physvol>
        <!-- Stereo sensors -->
        <physvol copynumber="20*3"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_stereo_pos" unit="mm" x="0.0" y="0.0" 
                    z="-56 + recoil_l14_sensor_sep" /> 
          <rotation name="recoil_l14_stereo_rot" unit="deg" x="0" y="0" z="stereo_angle"/>
        </physvol>

        <!-- Axial sensors --> 
        <physvol copynumber="20*4-10"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_axial_pos" unit="mm" x="0.0" y="0.0" 
                    z="-41 - recoil_l14_sensor_sep" /> 
        </physvol>
        <!-- Stereo sensors -->
        <physvol copynumber="20*4"> 
          <volumeref ref="recoil_l14_sensor_vol"/> 
          <position name="recoil_l14_stereo_pos" unit="mm" x="0.0" y="0.0" 
                    z="-41 + recoil_l14_sensor_sep" /> 
          <rotation name="recoil_l14_stereo_rot" unit="deg" x="0" y="0" z="-stereo_angle"/>
        </physvol>
      <!--</loop>-->

      <!-- Axial layer only sensors --> 
      <!--<loop for="i" from="1" to="10" step="1"> -->
        <physvol copynumber="89+1">
          <volumeref ref="recoil_l56_sensor_vol"/> 
          <position name="recoil_l5_sensor_pos" unit="mm" x="96.0" y="40"
                    z="-3" />  
        </physvol>  
        <physvol copynumber="99+1">
          <volumeref ref="recoil_l56_sensor_vol"/> 
          <position name="recoil_l6_sensor_pos" unit="mm" x="96.0"  y="40" 
                    z="87" />  
        </physvol>

        <physvol copynumber="89+2">
          <volumeref ref="recoil_l56_sensor_vol"/> 
          <position name="recoil_l5_sensor_pos" unit="mm" x="48.0" y="40"
                    z="-3" />  
        </physvol>  
        <physvol copynumber="99+2">
          <volumeref ref="recoil_l56_sensor_vol"/> 
          <position name="recoil_l6_sensor_pos" unit="mm" x="48.0"  y="40" 
                    z="87" />  
        </physvol>

        <physvol copynumber="89+3">
          <volumeref ref="recoil_l56_sensor_vol"/> 
          <position name="recoil_l5_sensor_pos" unit="mm" x="0.0" y="40"
                    z="-3" />  
        </physvol>  
