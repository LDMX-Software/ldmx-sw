                z="trig_scint_area_envelope_z/2+trigger_pad1_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <physvol copynumber="2*23-2">
          <volumeref ref="trigger_pad2_bar_volume" />
          <position name="trigger_pad2_bar_layer1_pos" unit="mm" x="-38*mm" 
                y="-target_dim_y/2 + trigger_bar_dy*(23 - 0.5) + trigger_pad_bar_gap*(23 - 1) + trigger_pad_offset" 
                z="trig_scint_area_envelope_z/2 + trigger_pad2_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>
        <physvol copynumber="2*23 - 1">
          <volumeref ref="trigger_pad2_bar_volume" />
          <position name="trigger_pad2_bar_layer2_pos" unit="mm" x="-38*mm"
                y="-target_dim_y/2 + trigger_bar_dy*23 + trigger_pad_bar_gap*(23 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad2_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <physvol copynumber="2*23-2">
          <volumeref ref="trigger_pad1_bar_volume" />
          <position name="trigger_pad1_bar_layer1_pos" unit="mm" x="-43*mm"
                y="-target_dim_y/2 + trigger_bar_dy*(23 - 0.5) + trigger_pad_bar_gap*(23 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad1_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>
        <physvol copynumber="2*23 - 1">
          <volumeref ref="trigger_pad1_bar_volume" />
          <position name="trigger_pad1_bar_layer2_pos" unit="mm" x="-43*mm"
                y="-target_dim_y/2 + trigger_bar_dy*23 + trigger_pad_bar_gap*(23 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad1_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <physvol copynumber="2*24-2">
          <volumeref ref="trigger_pad2_bar_volume" />
          <position name="trigger_pad2_bar_layer1_pos" unit="mm" x="-38*mm" 
                y="-target_dim_y/2 + trigger_bar_dy*(24 - 0.5) + trigger_pad_bar_gap*(24 - 1) + trigger_pad_offset" 
                z="trig_scint_area_envelope_z/2 + trigger_pad2_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>
        <physvol copynumber="2*24 - 1">
          <volumeref ref="trigger_pad2_bar_volume" />
          <position name="trigger_pad2_bar_layer2_pos" unit="mm" x="-38*mm"
                y="-target_dim_y/2 + trigger_bar_dy*24 + trigger_pad_bar_gap*(24 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad2_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <physvol copynumber="2*24-2">
          <volumeref ref="trigger_pad1_bar_volume" />
          <position name="trigger_pad1_bar_layer1_pos" unit="mm" x="-43*mm"
                y="-target_dim_y/2 + trigger_bar_dy*(24 - 0.5) + trigger_pad_bar_gap*(24 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad1_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>
        <physvol copynumber="2*24 - 1">
          <volumeref ref="trigger_pad1_bar_volume" />
          <position name="trigger_pad1_bar_layer2_pos" unit="mm" x="-43*mm"
                y="-target_dim_y/2 + trigger_bar_dy*24 + trigger_pad_bar_gap*(24 - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2+trigger_pad1_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>
      <!--</loop>-->

      <auxiliary auxtype="Region" auxvalue="trig_scint" />
      <!-- <auxiliary auxtype="VisAttributes" auxvalue="VisibleShowDau"/> -->
      <auxiliary auxtype="DetElem" auxvalue="TriggerPad"/>

    </volume>

    <volume name="World">
      <materialref ref="Vacuum"/>
      <solidref ref="world_box"/>
      <physvol copynumber="1">
        <volumeref ref="tagger"/>
        <positionref ref="tagger_pos"/>
        <rotationref ref="identity"/>
      </physvol> 
      <physvol copynumber="2">
        <volumeref ref="TS_trgt"/>
        <positionref ref="center" />
        <rotationref ref="identity"   /> 
      </physvol> 
      <physvol copynumber="3">
        <volumeref ref="trig_scint_tagger"/>
        <positionref ref="trig_scint_pos"/>
        <rotationref ref="identity"/>
      </physvol>
      <physvol copynumber="5">
        <volumeref ref="recoil"/>
        <positionref ref="recoil_pos"/>
        <rotationref ref="identity"/>
      </physvol>
      <physvol copynumber="6"> 
        <volumeref ref="em_calorimeters"/>
        <positionref ref="em_calorimeter_pos"/> 
        <rotationref ref="identity"/> 
	    </physvol>
      <physvol copynumber="7"> 
        <volumeref ref="hadronic_calorimeter"/>
        <positionref ref="hadron_calorimeter_pos"/> 
        <rotationref ref="identity"/> 
      </physvol>
      <physvol>
        <volumeref ref="ldmx_magnet"/>
        <positionref ref="magnet_pos"/> 
        <rotationref ref="identity"/> 
      </physvol>
      <auxiliary auxtype="DetElem" auxvalue="Top"/>
    </volume>
  </structure>

