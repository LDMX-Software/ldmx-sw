                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
                            y="--1*ecal_side_dy - -1*( 1200-1800 )/2."
