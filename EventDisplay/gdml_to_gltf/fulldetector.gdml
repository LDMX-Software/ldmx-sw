                            y="(-(ecal_side_dy/2.0-hcal_scintWidth/2.0)) - -1*hcal_scintWidth*(30-1)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZY_3_1_31_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (7+2*0)*256 + (31-1)">
                  <volumeref ref="side_hcal_scintZYVolume"/>
