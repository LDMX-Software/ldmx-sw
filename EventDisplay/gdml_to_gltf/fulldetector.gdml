                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (3-1)*side_hcal_layerThick + 2*side_hcal_layerThick*7 )"
                            y="(-(ecal_side_dy/2.0-hcal_scintWidth/2.0)) - -1*hcal_scintWidth*(3-1)"
