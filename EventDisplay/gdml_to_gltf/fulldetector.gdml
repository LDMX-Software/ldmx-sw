        <twoDimVertex x="171.45" y="194.31"/>
        <twoDimVertex x="188.58" y="108.87"/>
        <twoDimVertex x="254.00" y="51.33"/>
        <twoDimVertex x="254.00" y="-51.33"/>
        <twoDimVertex x="172.63" y="-99.67"/>
        <twoDimVertex x="171.45" y="-194.31"/>
        <twoDimVertex x="82.55" y="-245.63"/>
        <twoDimVertex x="0.00" y="-217.75"/>
        <twoDimVertex x="-82.55" y="-245.63"/>
        <twoDimVertex x="-171.45" y="-194.31"/>
        <twoDimVertex x="-172.63" y="-99.67"/>
        <twoDimVertex x="-254.00" y="-51.33"/>
        <twoDimVertex x="-254.00" y="51.33"/>
        <twoDimVertex x="-188.58" y="108.87"/>
        <twoDimVertex x="-171.45" y="194.31"/>
        <twoDimVertex x="-82.55" y="245.63"/>
