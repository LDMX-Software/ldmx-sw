                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (9-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_1_10_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+1+2*0)*256 + (10-1)">
                  <volumeref ref="side_hcal_scintX_1_Volume"/>
                  <position name="side_hcal_scintX_1_1_10_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)*-1 + -1*( 1800-1800 )/2."
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (10-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_1_11_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+1+2*0)*256 + (11-1)">
                  <volumeref ref="side_hcal_scintX_1_Volume"/>
                  <position name="side_hcal_scintX_1_1_11_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)*-1 + -1*( 1800-1800 )/2."
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (11-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintX_1_1_12_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (1+1+2*0)*256 + (12-1)">
                  <volumeref ref="side_hcal_scintX_1_Volume"/>
                  <position name="side_hcal_scintX_1_1_12_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)*-1 + -1*( 1800-1800 )/2."
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (12-1)*hcal_scintWidth"/>
                </physvol>
              <!--</loop>-->

              <!--
            Absorber plates oriented in x
            x (start): ecal_side_dx/2.0
                       +hcal_airThick+side_hcal_absoThick ( to account for absorber in y from the other sections )
            y (start): ecal_side_dy/2.0
                       +hcal_airThick+side_hcal_absoThick/2.0 ( to account for air and so that absorber is centered)
              -->
              <physvol name="side_hcal_absoX1_1_1_3_Physvol">
                <volumeref ref="side_hcal_absoX_1_Volume"/>
                <position name="side_hcal_absoX1_1_1_3_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick)) + -1*( 1800-1800 )/2."
                          y="(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0) - -1*( (3-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                          z="-back_hcal_dz/2.0"/>
              </physvol>

              <!--
            Short strips oriented in z
            x (start): ecal_side_dx/2.0 (similar to absorber but with different sign)
                       -hcal_scintWidth/2.0 ( so that scintillator is centered)
            y (start): ecal_side_dy/2.0
                       +2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0 ( to account for air,absober and so that scintillator is centered)
              -->
              <!--<loop for="strip" from="1" to="36" step="1">-->
                <physvol name="side_hcal_scintZX_1_1_1_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (3+2*0)*256 + (1-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_1_1_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(1-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (3-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_1_1_2_Physvol"
