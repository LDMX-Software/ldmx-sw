      <!-- 
       center strong back bar over the center of the carbon cooling plane
        and put it just above the carbon cooling plane
       assume PreShower layer uses the same strongback as the first bilayer
        with absorber
      --> 
      <physvol>
        <volumeref ref="strongback_bar_volume_0"/>
        <position name="strongback_bar_volume_PSpos" unit="mm" 
          x="strongback_pos_x"
          y="strongback_pos_y"
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + Flower_dz 
            + CarbonCoolingPlane_dz/2."/>
      </physvol>
      
      <!--
      Without the additional tungsten layer to allow for more longitudinal space,
        the cooling plane is too close to the motherboard to allow room for the 
        backplane boards and their connectors. Therefore, we need to move the cooling
        plane in this pre-shower layer back by an additional 1.5mm.
      -->
      <physvol>
        <volumeref ref="C_volume_CarbonCoolingPlane"/>
        <position name="PS_carbon_pos" unit="mm" x="0" y="-support_box_shift" 
          z="bilayer_start + FrontTolerance + PCB_dz + PCB_Motherboard_Gap + Flower_dz 
            + preshower_extra_air + CarbonCoolingPlane_dz/2."/>
      </physvol>

