        <!--ecal_define-->
        <!--
        The x,y vertices of the tungsten absorber polygon
        -->
        <matrix name="absorber_polygon"
                coldim="2"
                values="82.55 245.63
                        171.45 194.31
                        188.58 108.87
                        254.00 51.33
                        254.00 -51.33
                        172.63 -99.67
                        171.45 -194.31
                        82.55 -245.63
                        0.00 -217.75
                        -82.55 -245.63
                        -171.45 -194.31
                        -172.63 -99.67
                        -254.00 -51.33
                        -254.00 51.33
                        -188.58 108.87
                        -171.45 194.31
                        -82.55 245.63
                        0.00 199.34"/>

        <!--
        The position of the support box

        the support box is not symmetric in the vertical direction so
        center on the central cavern with
            y="-520.7/2.-support_box_shift"
        -->
        <position name="support_box_pos" unit="mm" 
        x="-880.6815/2." 
        y="-520.7/2.-support_box_shift"
        z="-300-102.616"/>

        <!--
        The transverse position of the strongbacks.

        The x-coordinate is centered with respect to the ecal envelope
        while the y-coordinate is shifted 12.7mm above the cooling plane
        which is how thick the shelf that they rest on is.
        -->
        <variable name="strongback_pos_x" value="1.8 + 0.6815/2." />
        <variable name="strongback_pos_y" 
        value="CarbonCoolingPlane_dy/2. + strongback_bar_dy/2. + 12.7/2."/>

        <!--
        The rotations and shifts putting the motherboards from their CAD exported coordinates into
        ECal coordinates with the origin at the center of the layer.

        The shifts are done _after_ the rotations.

        The x-shift is done by finding the x-cooridnate of the top hexagonal point
        of the motherboard and then lining that up with the top hexagonal point of the
        flower.

        The y-shift is found to center the hexagonal part of the motherboards on the flower.

        The z-shift is just making sure that we are moving the whole volume centered on
        itself.
        -->
        <rotation name="motherboard5_rotation" unit="deg" x="90" y="0" z="0"/>
        <position name="motherboard5_position_rel_to_layer" unit="mm" 
        x="-(Hex_radius+hexagon_gap)-(247.8682)"
        y="-408.2065/2"
        z="MotherBoardAssembly_dz/2"/>

        <rotation name="motherboard6_rotation" unit="deg" x="90" y="180" z="0"/>
        <position name="motherboard6_position_rel_to_layer" unit="mm" 
        x="(Hex_radius+hexagon_gap)+(255.2361)"
        y="242.1649"
        z="MotherBoardAssembly_dz/2"/>

        <!-- 
        loop variables for bilayers and modules
        -->
        <variable name="bilayer" value="1"/>
        <variable name="module" value="1"/>

        <!-- inside the ecal parent volume, the coordinate system is relative to it,
        so we need to subtract away half of its depth -->
        <variable name="bilayer_start" value="-ecal_envelope_z/2."/>

        <!-- extra air in pre-shower layer to make sure there is enough room between motehrboards
        and cooling plane for the backplane boards -->
        <variable name="preshower_extra_air" value="0.5"/>
        <!-- additional offset for start of sampling sections because pre-shower
                value="preshower_extra_air + 2*(MotherBoardAssembly_dz - PCB_dz)"/>
            has extra air -->
        <variable name="sampling_section_offset" 
                value="2*preshower_extra_air"/>

        <!-- flip over y-axis for odd-side of bilayer sandwich -->
        <rotation name="flip" unit="deg" x="0" y="180" z="0"/>

        <!--magnet_define-->
        <!-- Magnet dimensions -->
        <variable name="magnet_x" value="2095.5*mm" />
        <variable name="magnet_y" value="1460.5*mm" />
        <variable name="magnet_z" value="914.4*mm" />
        
        <!-- Dimensions of the magnet box -->
        <variable name="magnet_box_x" value="2150*mm" />
        <variable name="magnet_box_y" value="1500*mm" />
        <variable name="magnet_box_z" value="1225*mm" />

        <!-- Shim dimenisions -->
        <variable name="shim_x" value="482.6*mm"/>
        <variable name="shim_y" value="355.6*mm"/>
        <variable name="shim_z" value="914.4*mm"/>
        
        <position name="shim_left_pos" unit="mm" x="shim_x/2 - magnet_x/2 " y="0.0" z="0.0*mm" />
        <position name="shim_right_pos" unit="mm" x="magnet_x/2 - shim_x/2" y="0.0*mm" z="0.0*mm" />

        <!-- Corner iron blocks -->
        <variable name="corner_iron_block_x" value="482.6*mm"/>
        <variable name="corner_iron_block_y" value="552.45*mm"/>
        <variable name="corner_iron_block_z" value="914.4*mm"/>

        <position name="corner_iron_block_top_left_pos" unit="mm" x="corner_iron_block_x/2 - magnet_x/2" y="shim_y/2 + corner_iron_block_y/2" z="0.0*mm" />
        <position name="corner_iron_block_top_right_pos" unit="mm" x="magnet_x/2 - corner_iron_block_x/2" y="shim_y/2 + corner_iron_block_y/2" z="0.0*mm" />
        <position name="corner_iron_block_bot_left_pos" unit="mm" x="corner_iron_block_x/2 - magnet_x/2" y="-shim_y/2 - corner_iron_block_y/2" z="0.0*mm" />
        <position name="corner_iron_block_bot_right_pos" unit="mm" x="magnet_x/2 - corner_iron_block_x/2" y="-shim_y/2 - corner_iron_block_y/2" z="0.0*mm" />

        <!-- Center iron blocks -->
        <variable name="center_iron_block_x" value="magnet_x - 2*corner_iron_block_x" />
        <variable name="center_iron_block_y" value="476.25*mm" />
        <variable name="center_iron_block_z" value="914.4*mm" />

        <position name="center_iron_block_top_pos" unit="mm" x="0.0*mm" y="magnet_y/2 - center_iron_block_y/2" z="0.0*mm" />
        <position name="center_iron_block_bot_pos" unit="mm" x="0.0*mm" y="-magnet_y/2 + center_iron_block_y/2" z="0.0*mm" />

        <position name="v0" unit="mm" z="-457.200012207031" x="1047.75" y="730.25" />
