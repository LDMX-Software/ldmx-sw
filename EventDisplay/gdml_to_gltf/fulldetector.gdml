                     copynumber="1*256*256*256 + 0*256*256 + (95+1)*256 + (32-1)">
              <volumeref ref="back_hcal_scintYVolume"/>
              <position name="back_hcal_scintYPos" unit="mm"
                        x="back_hcal_startXScint + (32-1)*hcal_scintWidth"
                        y="0"
                        z="back_hcal_startZScint + (95)*back_hcal_layerThick"/>
            </physvol>

            <physvol name="back_hcal_scintYPhysvol"
                     copynumber="1*256*256*256 + 0*256*256 + (95+1)*256 + (33-1)">
              <volumeref ref="back_hcal_scintYVolume"/>
              <position name="back_hcal_scintYPos" unit="mm"
                        x="back_hcal_startXScint + (33-1)*hcal_scintWidth"
                        y="0"
                        z="back_hcal_startZScint + (95)*back_hcal_layerThick"/>
            </physvol>

            <physvol name="back_hcal_scintYPhysvol"
                     copynumber="1*256*256*256 + 0*256*256 + (95+1)*256 + (34-1)">
              <volumeref ref="back_hcal_scintYVolume"/>
              <position name="back_hcal_scintYPos" unit="mm"
                        x="back_hcal_startXScint + (34-1)*hcal_scintWidth"
                        y="0"
                        z="back_hcal_startZScint + (95)*back_hcal_layerThick"/>
            </physvol>

            <physvol name="back_hcal_scintYPhysvol"
