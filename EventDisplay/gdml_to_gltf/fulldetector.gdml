                            y="--1*ecal_side_dy - -1*( 1600-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (1-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintY_3_2_2_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (1+1+2*4)*256 + (2-1)">
