                          y="(-(ecal_side_dy/2.0+hcal_airThick+side_hcal_absoThick/2.0)) - 1*( (5-1)*side_hcal_layerThick + 2*side_hcal_layerThick*9 )"
                          z="-back_hcal_dz/2.0"/>
