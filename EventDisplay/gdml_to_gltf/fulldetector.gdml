        <!--
            Strongback Parts

            The strong back consists of a bar of alimunum with "fins" hanging down from it
            on either end to attach to the carbon cooling plane.

            Not currently implementing the "fins" hanging down because its complicated
            <box name="strongback_fin_rect" lunit="mm"
                x="101.6-76.2" y="50.8" z="3.175" />
            <xtru name="strongback_fin_triangle_left" lunit="mm">
            <twoDimVertex x="0" y="0" />
            <twoDimVertex x="0" y="-50.8" />
            <twoDimVertex x="162.4-76.2" y="0" />
            <section zOrder="0" zPosition="0" />
            <section zOrder="1" zPosition="3.175" />
            </xtru>
            <xtru name="strongback_fin_triangle_right" lunit="mm">
            <twoDimVertex x="0" y="0" />
            <twoDimVertex x="0" y="-50.8" />
            <twoDimVertex x="76.2-162.4" y="0" />
            <section zOrder="0" zPosition="0" />
            <section zOrder="1" zPosition="3.175" />
            </xtru>
        -->
