                            y="(-(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (7-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
