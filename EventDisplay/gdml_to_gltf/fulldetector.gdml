                <volumeref ref="side_hcal_absoY_2_Volume"/>
                <position name="side_hcal_absoY2_3_2_Pos" unit="mm"
                          x="(-(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick/2.0)) + -1*( (3)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                          y="(-(ecal_side_dy)) + -1*( 1600-1800 )/2."
                          z="-back_hcal_dz/2.0"/>
              </physvol>

              <!--
            Long strips oriented in y (each strip increases in x)
            x (start): ecal_side_dx/2.0 + (2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)
            y (start): ecal_side_dy
            z (start): -back_hcal_dz/2.0 - side_hcal_dz/2.0
                       + (strip-1)*hcal_scintWidth ( to account for different strips)
              -->
              <!--<loop for="strip" from="1" to="side_hcal_numScintXY" step="1">-->
                <physvol name="side_hcal_scintY_3_2_1_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (3+1+2*4)*256 + (1-1)">
