              <!--
            Absorber plates oriented in y
            x (start): ecal_side_dx/2.0 + (hcal_airThick+side_hcal_absoThick/2.0)
            y (start): ecal_side_dy ( if its ecal_side_dy/2.0, the absorber plates are not centered, use ecal_side_dy to get them centered)
              -->
              <physvol name="side_hcal_absoY1_4_1_3_Physvol">
                <volumeref ref="side_hcal_absoY_1_Volume"/>
                <position name="side_hcal_absoY1_4_1_3_Pos" unit="mm"
                          x="(ecal_side_dx/2.0+hcal_airThick+side_hcal_absoThick/2.0) + 1*( (3-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
                          y="((ecal_side_dy)) + 1*( 1800-1800 )/2."
                          z="-back_hcal_dz/2.0"/>
