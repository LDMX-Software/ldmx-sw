                  <position name="side_hcal_scintZX_2_1_7_Pos" unit="mm"
                            x="-1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + 1*(7-1)*hcal_scintWidth"
                            y="(-(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (7-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_2_1_8_Physvol"
                         copynumber="1*256*256*256 + (section)*256*256 + (7+2*0)*256 + (8-1)">
