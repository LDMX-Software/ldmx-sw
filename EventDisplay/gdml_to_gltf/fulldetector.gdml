                         copynumber="1*256*256*256 + (1)*256*256 + (5+2*4)*256 + (25-1)">
                  <volumeref ref="side_hcal_scintZXVolume"/>
                  <position name="side_hcal_scintZX_1_2_25_Pos" unit="mm"
                            x="--1*(ecal_side_dx/2.0-hcal_scintWidth/2.0) + -1*(25-1)*hcal_scintWidth"
                            y="(ecal_side_dy/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (5-1)*side_hcal_layerThick + 2*side_hcal_layerThick*4)"
                            z="-back_hcal_dz/2.0"/>
                </physvol>

                <physvol name="side_hcal_scintZX_1_2_26_Physvol"
                         copynumber="1*256*256*256 + (1)*256*256 + (5+2*4)*256 + (26-1)">
