                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            y="--1*ecal_side_dy - -1*( 1600-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (2-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintY_3_2_3_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (1+1+2*4)*256 + (3-1)">
                  <volumeref ref="side_hcal_scintY_2_Volume"/>
                  <position name="side_hcal_scintY_3_2_3_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            y="--1*ecal_side_dy - -1*( 1600-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (3-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintY_3_2_4_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (1+1+2*4)*256 + (4-1)">
                  <volumeref ref="side_hcal_scintY_2_Volume"/>
                  <position name="side_hcal_scintY_3_2_4_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
                            y="--1*ecal_side_dy - -1*( 1600-1800 )/2."
                            z="-back_hcal_dz/2.0 - side_hcal_dz/2.0 + hcal_scintWidth/2.0 + (4-1)*hcal_scintWidth"/>
                </physvol>

                <physvol name="side_hcal_scintY_3_2_5_Physvol"
                         copynumber="1*256*256*256 + (3)*256*256 + (1+1+2*4)*256 + (5-1)">
                  <volumeref ref="side_hcal_scintY_2_Volume"/>
                  <position name="side_hcal_scintY_3_2_5_Pos" unit="mm"
                            x="(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0) - -1*( (1)*side_hcal_layerThick + 2*side_hcal_layerThick*4 )"
