                  <position name="side_hcal_scintZY_4_1_36_Pos" unit="mm"
                            x="(-(ecal_side_dx/2.0+2.0*hcal_airThick+side_hcal_absoThick+hcal_scintThick/2.0)) - 1*( (3-1)*side_hcal_layerThick + 2*side_hcal_layerThick*0 )"
