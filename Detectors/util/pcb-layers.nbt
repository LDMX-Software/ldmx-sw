# numbat script https://numbat.dev/doc/cli-installation.html
# to help estimate the relative thickness of copper and FR4 in a PCB
fn _hexagon_area(side: Length) -> Area = 3*sqrt(3)/2*side*side
fn _copper_layer_weight(n: Scalar) = ((n-2)*(0.5 oz / ft^2) + 2*(1.0 oz / ft^2))

let hexagon_side : Length = 85 mm
let hexagon_thick : Length = 1.66 mm
let copper_density = 8.960 g / cm^3
let fr4_density = 2.000 g / cm^3

# best guess on the total number of copper layers in the PCB
let n_copper_layers : Scalar = 12

let hexagon_area : Area = _hexagon_area(hexagon_side)
let copper_thick = _copper_layer_weight(n_copper_layers)/copper_density
let fr4_thick = hexagon_thick - copper_thick

print("For {n_copper_layers} layers of Cu...")
print("      |    Cu    |   FR-4")
print("Depth | {copper_thick -> mm:.3f} | {fr4_thick -> mm:.3f}")

let copper_mass = copper_thick*hexagon_area*copper_density
let fr4_mass = fr4_thick*hexagon_area*fr4_density

print(" Mass | {copper_mass -> g:.3f} | {fr4_mass -> g:.3f}")

