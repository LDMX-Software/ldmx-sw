<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!DOCTYPE gdml [
<!ENTITY constants SYSTEM "constants.gdml">
]>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

  <define>
    <!-- loop variables - must be defined here -->
    <variable name="layer_index"  value="1"/>
    &constants;
  </define>
    
  <materials>
    <isotope N="16" Z="8" name="O16">
      <atom unit="g/mole" value="15.9949"/>
    </isotope>
    <isotope N="17" Z="8" name="O17">
      <atom unit="g/mole" value="16.9991"/>
    </isotope>
    <isotope N="18" Z="8" name="O18">
      <atom unit="g/mole" value="17.9992"/>
    </isotope>
    <element name="O">
      <fraction n="0.99757" ref="O16"/>
      <fraction n="0.00038" ref="O17"/>
      <fraction n="0.00205" ref="O18"/>
    </element>
    <isotope N="12" Z="6" name="C12">
      <atom unit="g/mole" value="12"/>
    </isotope>
    <isotope N="13" Z="6" name="C13">
      <atom unit="g/mole" value="13.0034"/>
    </isotope>
    <element name="C">
      <fraction n="0.9893" ref="C12"/>
      <fraction n="0.0107" ref="C13"/>
    </element>
    <isotope N="1" Z="1" name="H1">
      <atom unit="g/mole" value="1.00782503081372"/>
    </isotope>
    <isotope N="2" Z="1" name="H2">
      <atom unit="g/mole" value="2.01410199966617"/>
    </isotope>
    <element name="H">
      <fraction n="0.999885" ref="H1"/>
      <fraction n="0.000115" ref="H2"/>
    </element>
    <material name="G4_C" state="solid">
      <T unit="K" value="293.15"/>
      <MEE unit="eV" value="81"/>
      <D unit="g/cm3" value="2"/>
      <fraction n="1" ref="C"/>
    </material>
    <isotope N="14" Z="7" name="N14">
      <atom unit="g/mole" value="14.0031"/>
    </isotope>
    <isotope N="15" Z="7" name="N15">
      <atom unit="g/mole" value="15.0001"/>
    </isotope>
    <element name="N">
      <fraction n="0.99632" ref="N14"/>
      <fraction n="0.00368" ref="N15"/>
    </element>
    <isotope N="36" Z="18" name="Ar36">
      <atom unit="g/mole" value="35.9675"/>
    </isotope>
    <isotope N="38" Z="18" name="Ar38">
      <atom unit="g/mole" value="37.9627"/>
    </isotope>
    <isotope N="40" Z="18" name="Ar40">
      <atom unit="g/mole" value="39.9624"/>
    </isotope>
    <element name="Ar">
      <fraction n="0.003365" ref="Ar36"/>
      <fraction n="0.000632" ref="Ar38"/>
      <fraction n="0.996003" ref="Ar40"/>
    </element>
    <material name="G4_AIR" state="gas">
      <T unit="K" value="293.15"/>
      <MEE unit="eV" value="85.7"/>
      <D unit="g/cm3" value="0.00120479"/>
      <fraction n="0.000124000124000124" ref="C"/>
      <fraction n="0.755267755267755" ref="N"/>
      <fraction n="0.231781231781232" ref="O"/>
      <fraction n="0.0128270128270128" ref="Ar"/>
    </material>
    <isotope N="55" Z="25" name="Mn55">
      <atom unit="g/mole" value="54.938"/>
    </isotope>
    <element name="Mn">
      <fraction n="1" ref="Mn55"/>
    </element>
    <isotope N="54" Z="26" name="Fe54">
      <atom unit="g/mole" value="53.9396"/>
    </isotope>
    <isotope N="56" Z="26" name="Fe56">
      <atom unit="g/mole" value="55.9349"/>
    </isotope>
    <isotope N="57" Z="26" name="Fe57">
      <atom unit="g/mole" value="56.9354"/>
    </isotope>
    <isotope N="58" Z="26" name="Fe58">
      <atom unit="g/mole" value="57.9333"/>
    </isotope>
    <element name="Fe">
      <fraction n="0.05845" ref="Fe54"/>
      <fraction n="0.91754" ref="Fe56"/>
      <fraction n="0.02119" ref="Fe57"/>
      <fraction n="0.00282" ref="Fe58"/>
    </element>
    <material name="Steel" state="solid">
       <T unit="K" value="293.15"/>
       <D unit="g/cm3" value="7.87"/>
       <fraction n="0.9843" ref="G4_Fe"/>
       <fraction n="0.014" ref="G4_Mn"/>
       <fraction n="0.0017" ref="G4_C"/>
    </material>
    <material name="Aluminum3003" state="solid">
      <T unit="K" value="293.15"/>
      <D unit="g/cm3" value="2.6989"/>
      <fraction n="0.99" ref="Al"/>
      <fraction n="0.01" ref="Mn"/>
    </material>
    <material name="Scintillator" state="solid">
       <T unit="K" value="293.15"/>
       <!-- <MEE unit="eV" value="64.7494480275643"/> -->
       <D unit="g/cm3" value="1.032"/>
       <fraction n="0.91512109"  ref="G4_C"/>
       <fraction n="0.084878906" ref="G4_H"/>
    </material>

    <!-- Scintillator -->
    <material name="Polyvinyltoluene">
      <D type="density" value="1.023" unit="g/cm3"/>
      <composite n="27" ref="C"/>
      <composite n="30" ref="H"/>
    </material>

  </materials>


  <solids>
  
    <!-- - - - - - - - - HCal solids - - - - - - - -  -->
    <!-- Absorber -->
    <box lunit="mm" name="absorber_box"
          x="absorber_width"
          y="absorber_height"
          z="absorber_thickness"/>
    <tube lunit="mm" name="absorber_hole"
          z="absorber_thickness"
          rmax="absorber_hole_radius"
          deltaphi="2*pi"
          aunit="rad"/>

    <!-- Mounting plates  -->
    <box lunit="mm" name="vertical_bar_mounting_plate_box"
          x="bar_mounting_plate_vertical_x"
          y="bar_mounting_plate_vertical_y"
          z="bar_mounting_plate_thickness"/>
    <box lunit="mm" name="horizontal_bar_mounting_plate_box"
          x="bar_mounting_plate_horizontal_x"
          y="bar_mounting_plate_horizontal_y"
          z="bar_mounting_plate_thickness"/>

    <!-- Scintillators -->
    <!-- Front -->
    <box lunit="mm" name="front_vertical_scint_box"
          x="scint_front_vertical_x"
          y="scint_front_vertical_y"
          z="scint_thickness"/>
    <box lunit="mm" name="front_horizontal_scint_box"
          x="scint_front_horizontal_x"
          y="scint_front_horizontal_y"
          z="scint_thickness"/>
    <!-- Back -->
    <box lunit="mm" name="back_vertical_scint_box"
          x="scint_back_vertical_x"
          y="scint_back_vertical_y"
          z="scint_thickness"/>
    <box lunit="mm" name="back_horizontal_scint_box"
          x="scint_back_horizontal_x"
          y="scint_back_horizontal_y"
          z="scint_thickness"/>

    <!-- Scintillator covers -->
    <!-- Front -->
    <box lunit="mm" name="front_vertical_scint_cover_box"
          x="scint_front_vertical_x"
          y="scint_front_vertical_y"
          z="scint_bar_cover_thickness"/>
    <box lunit="mm" name="front_horizontal_scint_cover_box"
          x="scint_front_horizontal_x"
          y="scint_front_horizontal_y"
          z="scint_bar_cover_thickness"/>
    <!-- Back -->
    <box lunit="mm" name="back_vertical_scint_cover_box"
          x="scint_back_vertical_x"
          y="scint_back_vertical_y"
          z="scint_bar_cover_thickness"/>
    <box lunit="mm" name="back_horizontal_scint_cover_box"
          x="scint_back_horizontal_x"
          y="scint_back_horizontal_y"
          z="scint_bar_cover_thickness"/>

    <!-- - - - - - - - - Parent Solids - - - - - - - -->
    <box lunit="mm" name="hadron_calorimeter_Box" x="hcal_dx" y="hcal_dy" z="hcal_dz"/>

  </solids>
  
  <structure>      
    
    <!-- Absorber -->
    <volume name="absorber_volume">
      <materialref ref="Steel"/>
      <solidref ref="absorber_box"/>
      <auxiliary auxtype="Color" auxvalue="Red"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>

    <!-- Mounting plates -->
    <volume name="vertical_bar_mounting_plate_volume">
      <materialref ref="Steel"/>
      <solidref ref="vertical_bar_mounting_plate_box"/>
      <auxiliary auxtype="Color" auxvalue="Red"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <volume name="horizontal_bar_mounting_plate_volume">
      <materialref ref="Steel"/>
      <solidref ref="horizontal_bar_mounting_plate_box"/>
      <auxiliary auxtype="Color" auxvalue="Red"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>

    <!-- Scintillators -->  
    <!-- Front -->
    <volume name="front_vertical_scint_box_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="front_vertical_scint_box"/>
      <auxiliary auxtype="SensDet" auxvalue="HcalSD"/>
      <auxiliary auxtype="Color" auxvalue="Blue"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <volume name="front_horizontal_scint_box_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="front_horizontal_scint_box"/>
      <auxiliary auxtype="SensDet" auxvalue="HcalSD"/>
      <auxiliary auxtype="Color" auxvalue="Blue"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <!-- Back -->
    <volume name="back_vertical_scint_box_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="back_vertical_scint_box"/>
      <auxiliary auxtype="SensDet" auxvalue="HcalSD"/>
      <auxiliary auxtype="Color" auxvalue="Blue"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <volume name="back_horizontal_scint_box_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="back_horizontal_scint_box"/>
      <auxiliary auxtype="SensDet" auxvalue="HcalSD"/>
      <auxiliary auxtype="Color" auxvalue="Blue"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>  

    <!-- Scintillator covers -->
    <!-- Front -->
    <volume name="front_vertical_scint_cover_box_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="front_vertical_scint_cover_box"/>
      <auxiliary auxtype="Color" auxvalue="White"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <volume name="front_horizontal_scint_cover_box_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="front_horizontal_scint_cover_box"/>
      <auxiliary auxtype="Color" auxvalue="White"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <!-- Back -->
    <volume name="back_vertical_scint_cover_box_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="back_vertical_scint_cover_box"/>
      <auxiliary auxtype="Color" auxvalue="White"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
    <volume name="back_horizontal_scint_cover_box_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="back_horizontal_scint_cover_box"/>
      <auxiliary auxtype="Color" auxvalue="White"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
    </volume>
      
      <!-- - - - - - - - -  FULL HCAL STRUCTURES - - - - - - - -  -->
    <volume name="hadronic_calorimeter">
      <materialref ref="G4_AIR" />
      <solidref ref="hadron_calorimeter_Box" />

      <!-- Absorber layers -->
      <loop for="layer_index" from="1" to="num_absorbers" step="1">
        <physvol name="absorber_physvol" copynumber="layer_index">
          <volumeref ref="absorber_volume"/>
          <position name="absorber_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_absorber_layer + first_layer_absorber_zpos"/>
        </physvol>
      </loop>

      <!-- Even CopyNumber means horizontal, odd means vertical -->
      <!-- Front Vertical Layers -->
      <loop for="layer_index" from="1" to="num_layers_front_vertical" step="1">
        <physvol name="front_vertical_scint_cover_physvol" copynumber="2*layer_index - 1">
          <volumeref ref="front_vertical_scint_cover_box_volume"/>
          <position name="front_vertical_scint_cover_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_scint_cover_zpos"/>
        </physvol>
        <physvol name="front_vertical_scint_physvol" copynumber="2*layer_index - 1">
          <volumeref ref="front_vertical_scint_box_volume"/>
          <position name="front_vertical_scint_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_scint_zpos"/>
        </physvol>
        <physvol name="vertical_bar_mounting_plate_physvol" copynumber="2*layer_index - 1">
          <volumeref ref="vertical_bar_mounting_plate_volume"/>
          <position name="vertical_bar_mounting_plate_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_bar_mounting_plate_zpos"/>
        </physvol>
      </loop>

      <!-- Front Horizontal Layers-->
      <!-- Note: extra "layer_thickness" offset corresponds to the first vertical layer -->
      <loop for="layer_index" from="1" to="num_layers_front_horizontal" step="1">
        <physvol name="front_horizontal_scint_cover_physvol" copynumber="2*layer_index">
          <volumeref ref="front_horizontal_scint_cover_box_volume"/>
          <position name="front_horizontal_scint_cover_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + layer_thickness + first_layer_scint_cover_zpos"/>
        </physvol>
        <physvol name="front_horizontal_scint_physvol" copynumber="2*layer_index">
          <volumeref ref="front_horizontal_scint_box_volume"/>
          <position name="front_horizontal_scint_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + layer_thickness + first_layer_scint_zpos"/>
        </physvol>
        <physvol name="horizontal_bar_mounting_plate_physvol" copynumber="2*layer_index">
          <volumeref ref="horizontal_bar_mounting_plate_volume"/>
          <position name="horizontal_bar_mounting_plate_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + layer_thickness + first_layer_bar_mounting_plate_zpos"/>
        </physvol>
      </loop>

      <!-- Back Horizontal Layers-->
      <loop for="layer_index" from="1" to="num_layers_back_horizontal" step="1">
        <physvol name="back_horizontal_scint_cover_physvol" copynumber="num_layers_front + 2*layer_index - 1">
          <volumeref ref="back_horizontal_scint_cover_box_volume"/>
          <position name="back_horizontal_scint_cover_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + first_layer_scint_cover_zpos"/>
        </physvol>
        <physvol name="back_horizontal_scint_physvol" copynumber="num_layers_front + 2*layer_index - 1">
          <volumeref ref="back_horizontal_scint_box_volume"/>
          <position name="back_horizontal_scint_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + first_layer_scint_zpos"/>
        </physvol>
        <physvol name="bacK_horizontal_bar_mounting_plate_physvol" copynumber="2*layer_index">
          <volumeref ref="horizontal_bar_mounting_plate_volume"/>
          <position name="back_horizontal_bar_mounting_plate_pos" unit="mm"
                    x="bar_x_displacement"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + first_layer_bar_mounting_plate_zpos"/>
        </physvol>
      </loop>

      <!-- Note: extra "layer_thickness" offset corresponds to the first horizontal layer -->
      <!-- Back Vertical Layers-->
      <loop for="layer_index" from="1" to="num_layers_back_vertical" step="1">
        <physvol name="back_vertical_scint_cover_physvol" copynumber="num_layers_front + 2*layer_index - 1">
          <volumeref ref="back_vertical_scint_cover_box_volume"/>
          <position name="back_vertical_scint_cover_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + layer_thickness + first_layer_scint_cover_zpos"/>
        </physvol>
        <physvol name="back_vertical_scint_physvol" copynumber="num_layers_front + 2*layer_index">
          <volumeref ref="back_vertical_scint_box_volume"/>
          <position name="back_back_vertical_scint_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + layer_thickness + first_layer_scint_zpos"/>
        </physvol>
        <physvol name="back_vertical_bar_mounting_plate_physvol" copynumber="2*layer_index - 1">
          <volumeref ref="vertical_bar_mounting_plate_volume"/>
          <position name="back_vertical_bar_mounting_plate_pos" unit="mm"
                    x="0"
                    y="0"
                    z="(layer_index - 1)*distance_to_subsequent_scint_layer + back_start + layer_thickness + first_layer_bar_mounting_plate_zpos"/>
        </physvol>
      </loop>

      <auxiliary auxtype="Region" auxvalue="CalorimeterRegion"/>
      <auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>
      <auxiliary auxtype="DetElem" auxvalue="Hcal"/>
    </volume>
  </structure>
  
  <setup name="Default" version="1.0">
    <world ref="hadronic_calorimeter"/>
  </setup>
</gdml>
