<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE gdml [
<!ENTITY constants SYSTEM "constants.gdml">
]>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

  <define>
    &constants;   
    <variable name="x" value="1"/>
  </define>

  <solids>
    <box lunit="mm" name="light_pipe_bar_box" x="light_pipe_dx" y="light_pipe_dy" z="light_pipe_thickness"/>
    <box lunit="mm" name="light_pipe_module_box" x="trig_scint_area_envelope_x" y="trig_scint_area_envelope_y" z="trig_scint_area_envelope_z"/>
  </solids>

  <materials>
    <material name="AcrylicPMMA">
      <D type="density" value="1.19" unit="g/cm3"/>
      <composite n="5" ref="C"/>
      <composite n="8" ref="H"/>
      <composite n="2" ref="O"/>
    </material>
    <material name="Vacuum" state="gas">
      <MEE unit="eV" value="19.2"/>
      <D unit="g/cm3" value="9.99999473841014e-09"/>
      <fraction n="1" ref="H"/>
    </material>
  </materials>

  <structure>
    <!-- Light pipe bar volume -->
    <volume name="light_pipe_bar_volume">
      <materialref ref="AcrylicPMMA"/>
      <solidref ref="light_pipe_bar_box"/>
      <auxiliary auxtype="DetElem" auxvalue="LightPipe"/>
      <auxiliary auxtype="VisAttributes" auxvalue="TriggerPadVis"/>
    </volume>

    <!-- Main light pipe module volume -->
    <volume name="light_pipes_module">
      <materialref ref="Vacuum"/>
      <solidref ref="light_pipe_module_box"/>
      
      <!-- Place light pipes for all 3 pads -->
      <loop for="x" to="number_of_bars" step="1">
        <!-- Pad 1 light pipes -->
        <physvol copynumber="6*x-5">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad1_bar_layer1_pos" unit="mm" 
                x="-21.5*mm"
                y="-target_dim_y/2 + trigger_bar_dy*(x - 0.5) + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad1_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2 + light_pipe_pad1_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>
        <physvol copynumber="6*x-4">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad1_bar_layer2_pos" unit="mm" 
                x="-21.5*mm"
                y="-target_dim_y/2 + trigger_bar_dy*x + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad1_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2 + light_pipe_pad1_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>

        <!-- Pad 2 light pipes -->
        <physvol copynumber="6*x-3">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad2_bar_layer1_pos" unit="mm" 
                x="-19*mm"
                y="-target_dim_y/2 + trigger_bar_dy*(x - 0.5) + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad2_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2 + light_pipe_pad2_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>
        <physvol copynumber="6*x-2">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad2_bar_layer2_pos" unit="mm" 
                x="-19*mm"
                y="-target_dim_y/2 + trigger_bar_dy*x + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad2_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2 + light_pipe_pad2_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>

        <!-- Pad 3 light pipes -->
        <physvol copynumber="6*x-1">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad3_bar_layer1_pos" unit="mm" 
                x="0*mm"
                y="-target_dim_y/2 + trigger_bar_dy*(x - 0.5) + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad3_z - trigger_pad_bar_thickness/2 - trigger_pad_bar_gap/2 + light_pipe_pad3_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>
        <physvol copynumber="6*x">
          <volumeref ref="light_pipe_bar_volume"/>
          <position name="light_pipe_pad3_bar_layer2_pos" unit="mm" 
                x="0*mm"
                y="-target_dim_y/2 + trigger_bar_dy*x + trigger_pad_bar_gap*(x - 1) + trigger_pad_offset"
                z="trig_scint_area_envelope_z/2 + trigger_pad3_z + trigger_pad_bar_thickness/2 + trigger_pad_bar_gap/2 + light_pipe_pad3_z_offset"/>
          <rotationref ref="identity"/>
        </physvol>
      </loop>

      <auxiliary auxtype="Region" auxvalue="light_pipe"/>
      <auxiliary auxtype="DetElem" auxvalue="LightPipe"/>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="light_pipes_module"/>
  </setup>
</gdml>