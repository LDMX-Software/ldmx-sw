<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE gdml [
  <!ENTITY constants SYSTEM "constants.gdml">
]>
<gdml xmlns:gdml="http://cern.ch/2001/Schemas/GDML" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd" >


  <define>

    &constants;

    <!-- loop variable -->
    <variable name="x" value="1"/>

  </define>

  <solids>

    <!-- Parent LP module envelope: same as TS envelope -->
    <box lunit="mm" name="lp_pad_box"
         x="trig_scint_area_envelope_x"
         y="trig_scint_area_envelope_y"
         z="trig_scint_area_envelope_z"/>

    <!-- Single light-pipe bar: 2 mm (y) x 2 mm (z), same x-length as TS bars -->
    <box lunit="mm" name="light_pipe_bar_box"
         x="trigger_bar_dx"
         y="lp_bar_dy"
         z="trigger_pad_bar_thickness"/>

  </solids>

  <materials>

    <material name="Vacuum" state="gas">
      <MEE unit="eV" value="19.2"/>
      <D unit="g/cm3" value="9.99999473841014e-09"/>
      <fraction n="1" ref="H"/>
    </material>

    <!-- Not strictly needed here, but harmless if present -->
    <material name="Polyvinyltoluene">
      <D type="density" value="1.023" unit="g/cm3"/>
      <composite n="27" ref="C"/>
      <composite n="30" ref="H"/>
    </material>

    <!-- Light pipes: PMMA -->
    <material name="AcrylicPMMA">
      <D type="density" value="1.19" unit="g/cm3"/>
      <composite n="5" ref="C"/>
      <composite n="8" ref="H"/>
      <composite n="2" ref="O"/>
    </material>

  </materials>

  <structure>

    <!-- One LP bar volume for pad 2 -->
    <volume name="lp_pad2_bar_volume">
      <materialref ref="AcrylicPMMA"/>
      <solidref ref="light_pipe_bar_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="TriggerPadVis"/>
      <auxiliary auxtype="DetElem"       auxvalue="LightPipe"/>
    </volume>

    <!-- One LP bar volume for pad 1 -->
    <volume name="lp_pad1_bar_volume">
      <materialref ref="AcrylicPMMA"/>
      <solidref ref="light_pipe_bar_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="TriggerPadVis"/>
      <auxiliary auxtype="DetElem"       auxvalue="LightPipe"/>
    </volume>

    <!-- Light-pipe module for TS pads 1 & 2 -->
    <volume name="ts_light_pipes">
      <materialref ref="Vacuum"/>
      <solidref ref="lp_pad_box" />

      <!--
        Loop over bar index:
        number_of_bars = 12  →  12 bars per layer
        We place 2 layers →  24 bars per pad
      -->
      <loop for="x" to="number_of_bars" step="1">

        <!-- ===================== -->
        <!-- PAD 2 (downstream pad) -->
        <!-- ===================== -->

        <!-- Pad 2, layer 1 -->
        <physvol copynumber="2*x-2">
          <volumeref ref="lp_pad2_bar_volume" />
          <position name="lp_pad2_bar_layer1_pos" unit="mm"
                    x="0"
                    y="-target_dim_y/2
                       + lp_bar_dy*(x - 0.5)
                       + lp_bar_y_gap*(x - 1)
                       + lp_pad_offset"
                    z="trig_scint_area_envelope_z/2
                       + trigger_pad2_z
                       - trigger_pad_bar_thickness/2
                       - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <!-- Pad 2, layer 2 -->
        <physvol copynumber="2*x-1">
          <volumeref ref="lp_pad2_bar_volume" />
          <position name="lp_pad2_bar_layer2_pos" unit="mm"
                    x="0"
                    y="-target_dim_y/2
                       + lp_bar_dy*(x - 0.5)
                       + lp_bar_y_gap*(x - 1)
                       + lp_pad_offset
                       + lp_layer_y_shift"
                    z="trig_scint_area_envelope_z/2
                       + trigger_pad2_z
                       + trigger_pad_bar_thickness/2
                       + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <!-- ===================== -->
        <!-- PAD 1 (upstream pad)   -->
        <!-- ===================== -->

        <!-- Pad 1, layer 1 -->
        <physvol copynumber="2*x-2">
          <volumeref ref="lp_pad1_bar_volume" />
          <position name="lp_pad1_bar_layer1_pos" unit="mm"
                    x="0"
                    y="-target_dim_y/2
                       + lp_bar_dy*(x - 0.5)
                       + lp_bar_y_gap*(x - 1)
                       + lp_pad_offset"
                    z="trig_scint_area_envelope_z/2
                       + trigger_pad1_z
                       - trigger_pad_bar_thickness/2
                       - trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

        <!-- Pad 1, layer 2 -->
        <physvol copynumber="2*x-1">
          <volumeref ref="lp_pad1_bar_volume" />
          <position name="lp_pad1_bar_layer2_pos" unit="mm"
                    x="0"
                    y="-target_dim_y/2
                       + lp_bar_dy*(x - 0.5)
                       + lp_bar_y_gap*(x - 1)
                       + lp_pad_offset
                       + lp_layer_y_shift"
                    z="trig_scint_area_envelope_z/2
                       + trigger_pad1_z
                       + trigger_pad_bar_thickness/2
                       + trigger_pad_bar_gap/2" />
          <rotationref ref="identity" />
        </physvol>

      </loop>

      <auxiliary auxtype="Region"  auxvalue="trig_scint"/>
      <auxiliary auxtype="DetElem" auxvalue="LightPipe"/>

    </volume>

  </structure>

  <setup name="Default" version="1.0">
    <world ref="ts_light_pipes"/>
  </setup>
</gdml>
