<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

  <!--
    ECAL support box for the Aug-2025 single-module vertical-slice test beam.
    Rebuilt parametrically from ECal_testBeam_Aug2025.STEP (see HANDOVER.md).
    Air mother volume holding thin Aluminum skins, 8020 T-slot rails, and the
    PlaneBracket plate-support bars.  Local frame: origin = box center, z = beam.
    Generated by step_tools/generate_support_box.py (do not hand-edit).
  -->

  <define>
    <position name="front_0_pos" unit="mm" x="0" y="0" z="-114.7"/>
    <position name="front_1_pos" unit="mm" x="0" y="0" z="114.7"/>
    <position name="side_0_pos" unit="mm" x="-229" y="0" z="0"/>
    <position name="side_1_pos" unit="mm" x="0" y="-229" z="0"/>
    <position name="bottom_pos" unit="mm" x="202.8" y="0" z="0"/>
