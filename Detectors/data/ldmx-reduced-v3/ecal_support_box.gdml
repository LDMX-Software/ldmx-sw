    <position name="rail_x7_0_pos" unit="mm" x="-215.9" y="-215.9" z="0"/>
    <position name="rail_x7_1_pos" unit="mm" x="215.9" y="215.9" z="0"/>
    <position name="rail_x7_2_pos" unit="mm" x="215.9" y="-215.9" z="0"/>
    <position name="rail_x7_3_pos" unit="mm" x="215.9" y="-76.2" z="0"/>
