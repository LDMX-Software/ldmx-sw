<?xml version='1.0' encoding='UTF-8'?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gdml.xsd">
  <!--
HCal above_ecal: 4 crossed layers, 32 separate scintillator bars.
Dimensions/materials and packed IDs follow iss2119; positions follow the STEP body centers.
The CAD body is replaced, not overlaid with active material. Bar counts are inferred from CAD width.
The air envelope is local to this station; it does not span the tracker or ECal.
-->
  <define/>
  <solids>
    <box name="hcal_above_ecal_envelope" lunit="mm" x="2002" y="2002" z="99.200000001"/>
