        <position name="hcal_top_layer2_strip10_pos" unit="mm" x="0" y="223.648114248" z="-11.9357910155"/>
      </physvol>
      <physvol name="hcal_top_layer2_strip11" copynumber="16843275">
        <volumeref ref="hcal_top_scint_box_x_volume"/>
        <position name="hcal_top_layer2_strip11_pos" unit="mm" x="0" y="273.648114248" z="-11.9357910155"/>
      </physvol>
      <physvol name="hcal_top_cover_1_placement">
        <volumeref ref="hcal_top_cover_1_volume"/>
        <position name="hcal_top_cover_1_pos" unit="mm" x="3.4716640023" y="0" z="21.6857910155"/>
      </physvol>
      <physvol name="hcal_top_cover_2_placement">
        <volumeref ref="hcal_top_cover_2_volume"/>
        <position name="hcal_top_cover_2_pos" unit="mm" x="0" y="-1.35188575204" z="-1.6857910155"/>
      </physvol>
      <auxiliary auxtype="Region" auxvalue="CalorimeterRegion"/>
      <auxiliary auxtype="DetElem" auxvalue="Hcal"/>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="hcal_top"/>
  </setup>
</gdml>
