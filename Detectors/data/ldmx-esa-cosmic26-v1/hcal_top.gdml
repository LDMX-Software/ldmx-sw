      </physvol>
      <physvol name="hcal_top_layer1_strip9" copynumber="16843017">
        <volumeref ref="hcal_top_scint_box_y_volume"/>
        <position name="hcal_top_layer1_strip9_pos" unit="mm" x="178.471664002" y="0" z="11.4357910155"/>
      </physvol>
      <physvol name="hcal_top_layer1_strip10" copynumber="16843018">
        <volumeref ref="hcal_top_scint_box_y_volume"/>
        <position name="hcal_top_layer1_strip10_pos" unit="mm" x="228.471664002" y="0" z="11.4357910155"/>
      </physvol>
      <physvol name="hcal_top_layer1_strip11" copynumber="16843019">
        <volumeref ref="hcal_top_scint_box_y_volume"/>
        <position name="hcal_top_layer1_strip11_pos" unit="mm" x="278.471664002" y="0" z="11.4357910155"/>
      </physvol>
      <!--Layer 2: CAD occurrence 1165, center Z=3735.339410 mm; each strip is a separate physical volume.-->
      <physvol name="hcal_top_layer2_strip0" copynumber="16843264">
        <volumeref ref="hcal_top_scint_box_x_volume"/>
        <position name="hcal_top_layer2_strip0_pos" unit="mm" x="0" y="-276.351885752" z="-11.9357910155"/>
      </physvol>
      <physvol name="hcal_top_layer2_strip1" copynumber="16843265">
        <volumeref ref="hcal_top_scint_box_x_volume"/>
        <position name="hcal_top_layer2_strip1_pos" unit="mm" x="0" y="-226.351885752" z="-11.9357910155"/>
      </physvol>
      <physvol name="hcal_top_layer2_strip2" copynumber="16843266">
        <volumeref ref="hcal_top_scint_box_x_volume"/>
