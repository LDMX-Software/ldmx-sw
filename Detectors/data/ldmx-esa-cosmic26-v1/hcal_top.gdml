      </physvol>
      <physvol name="hcal_top_layer2_strip4" copynumber="16843268">
        <volumeref ref="hcal_top_scint_box_x_volume"/>
        <position name="hcal_top_layer2_strip4_pos" unit="mm" x="0" y="-76.351885752" z="-11.9357910155"/>
      </physvol>
      <physvol name="hcal_top_layer2_strip5" copynumber="16843269">
