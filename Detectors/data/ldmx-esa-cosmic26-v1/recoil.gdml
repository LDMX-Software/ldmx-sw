<?xml version='1.0' encoding='UTF-8'?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gdml.xsd">
  <!--
Numeric recoil module compiled from ldmx-reduced-v3/recoil.gdml.
Source comments and physical definitions live in that ESA file; scalar expressions and loops are expanded here.
Sensitive-volume names, copy numbers and material definitions are preserved. Placement is in detector.gdml.
-->
  <define>
    <position name="recoil_center" x="0" y="0" z="0" unit="mm"/>
    <rotation name="recoil_identity" x="0" y="0" z="0" unit="radian"/>
  </define>
  <solids>
    <box lunit="mm" name="recoil_l14_active_sensor_box" x="48" y="78" z="0.32"/>
    <box lunit="mm" name="recoil_l14_sensor_box" x="50" y="80" z="0.32"/>
    <box lunit="mm" name="recoil_box" x="430" y="350" z="220"/>
    <box lunit="mm" name="recoil_downstream_cut_box" x="430" y="350" z="2000"/>
    <subtraction name="recoil_box_trimmed">
      <first ref="recoil_box"/>
      <second ref="recoil_downstream_cut_box"/>
      <position name="recoil_position_1" unit="mm" x="0" y="0" z="1040"/>
    </subtraction>
  </solids>
  <structure>
    <volume name="Recoil_l14_active_Sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l14_active_sensor_box"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleNoDau"/>
    </volume>
    <volume name="recoil_l14_sensor_vol">
      <materialref ref="Silicon"/>
      <solidref ref="recoil_l14_sensor_box"/>
      <physvol name="recoil_l14_active_sensor">
        <volumeref ref="Recoil_l14_active_Sensor_vol"/>
        <position name="recoil_position_2" unit="mm" x="0" y="0" z="0"/>
      </physvol>
      <auxiliary auxtype="VisAttributes" auxvalue="SiliconMaterialVis"/>
      <auxiliary auxtype="VisAttributes" auxvalue="RecoilRegionVis"/>
    </volume>
    <volume name="recoil">
      <materialref ref="Air"/>
      <solidref ref="recoil_box_trimmed"/>
      <physvol copynumber="10">
        <volumeref ref="recoil_l14_sensor_vol"/>
        <position name="recoil_position_4" unit="mm" x="0" y="0" z="-103"/>
      </physvol>
      <physvol copynumber="20">
        <volumeref ref="recoil_l14_sensor_vol"/>
        <position name="recoil_position_5" unit="mm" x="0" y="0" z="-97"/>
        <rotation name="recoil_rotation_6" unit="deg" x="0" y="0" z="5.72957795130823"/>
      </physvol>
      <physvol copynumber="30">
        <volumeref ref="recoil_l14_sensor_vol"/>
        <position name="recoil_position_7" unit="mm" x="0" y="0" z="-3"/>
      </physvol>
      <physvol copynumber="40">
        <volumeref ref="recoil_l14_sensor_vol"/>
        <position name="recoil_position_8" unit="mm" x="0" y="0" z="3"/>
        <rotation name="recoil_rotation_9" unit="deg" x="0" y="0" z="-5.72957795130823"/>
      </physvol>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleShowDau"/>
      <auxiliary auxtype="VisAttributes" auxvalue="InvisibleShowDau"/>
      <auxiliary auxtype="DetElem" auxvalue="recoil"/>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="recoil"/>
  </setup>
</gdml>
