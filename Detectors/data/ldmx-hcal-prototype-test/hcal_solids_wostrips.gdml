

<!-- Scintillators -->
<!-- Does not specify individual strips -->

<box lunit="mm" name="alongx_scint_box"
      x="scint_alongx_x"
      y="scint_thickness"
      z="scint_alongx_z"/>
<box lunit="mm" name="alongz_scint_box"
      x="scint_alongz_x"
      y="scint_thickness"
      z="scint_alongz_z"/>


<!-- Scintillator covers -->

<box lunit="mm" name="alongx_scint_cover_box"
      x="scint_alongx_x"
      y="scint_bar_cover_thickness"
      z="scint_alongx_z"/>
<box lunit="mm" name="alongz_scint_cover_box"
      x="scint_alongz_x"
      y="scint_bar_cover_thickness"
      z="scint_alongz_z"/>

<!-- Air -->

<box lunit="mm" name="air_box" x="dx" y="dy" z="air_thickness"/>
