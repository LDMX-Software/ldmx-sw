<!-- Scintillators -->
<!-- Front -->
<volume name="alongx_scint_box_volume">
  <materialref ref="Scintillator"/>
  <solidref ref="alongx_scint_box"/>
   
  <!--Tels geant4 this is a sensitive detector, meaning it record hits, stores energy etc.-->
  <!--<auxiliary auxtype="SensDet" auxvalue="HcalSD"/>-->
  <!--attributes for visulization-->
  <auxiliary auxtype="Color" auxvalue="Blue"/>
  <!--not sure...maybe somehow makes the visualization more indepth?-->
  <!--<auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>-->
  
</volume>
<volume name="alongz_scint_box_volume">
  <materialref ref="Scintillator"/>
  <solidref ref="alongz_scint_box"/>
  <!--<auxiliary auxtype="SensDet" auxvalue="HcalSD"/>-->
  <auxiliary auxtype="Color" auxvalue="Blue"/>
  <!--<auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>-->
</volume>


<!-- Scintillator covers -->

<volume name="alongx_scint_cover_box_volume">
  <materialref ref="Aluminum3003"/>
  <solidref ref="alongx_scint_cover_box"/>
  <auxiliary auxtype="Color" auxvalue="White"/>
  <!--<auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>-->
</volume>
<volume name="alongz_scint_cover_box_volume">
  <materialref ref="Aluminum3003"/>
  <solidref ref="alongz_scint_cover_box"/>
  <auxiliary auxtype="Color" auxvalue="White"/>
  <!--<auxiliary auxtype="VisAttributes" auxvalue="HcalVis"/>-->
</volume>
