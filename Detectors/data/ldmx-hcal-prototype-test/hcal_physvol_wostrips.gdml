
<!-- Even CopyNumber means alongz, odd means alongx -->
<!-- alongx Layers -->

<loop for="layer_index" from="1" to="num_layers_alongx" step="1">
  <physvol name="alongx_scint_cover_physvol" copynumber="2*layer_index - 1">
    <volumeref ref="alongx_scint_cover_box_volume"/>
    <position name="alongx_scint_cover_pos" unit="mm"
              x="0"
              y="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_scint_cover_ypos"
              z="0"/>
  </physvol>
  <physvol name="alongx_scint_physvol" copynumber="2*layer_index - 1">
    <volumeref ref="alongx_scint_box_volume"/>
    <position name="alongx_scint_pos" unit="mm"
              x="0"
              y="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_scint_ypos"
              z="0"/>
  </physvol>
</loop>

  <!-- alongz Layers-->
<!-- Note: extra "layer_thickness" offset corresponds to the first alongx layer -->
<loop for="layer_index" from="1" to="num_layers_alongz" step="1">
  <physvol name="alongz_scint_cover_physvol" copynumber="2*layer_index">
    <volumeref ref="alongz_scint_cover_box_volume"/>
    <position name="alongz_scint_cover_pos" unit="mm"
              x="0"
              y="(layer_index - 1)*distance_to_subsequent_scint_layer + first_layer_scint_cover_ypos + layer_thickness"
              z="0"/>
  </physvol>
  <physvol name="alongz_scint_physvol" copynumber="2*layer_index">
    <volumeref ref="alongz_scint_box_volume"/>
    <position name="alongz_scint_pos" unit="mm"
              x="0"
              y="(layer_index - 1)*distance_to_subsequent_scint_layer + layer_thickness + first_layer_scint_ypos"
              z="0"/>
  </physvol>
</loop>