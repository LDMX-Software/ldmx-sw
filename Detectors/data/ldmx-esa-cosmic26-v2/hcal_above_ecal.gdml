<?xml version='1.0' encoding='UTF-8'?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gdml.xsd">
  <!--
HCal above_ecal: 4 crossed layers, 32 separate scintillator bars.
Positions from CosmicTestStandScienceOnly.stp (2026-11-02): plane body centers,
50 mm strips centered across each plane, bar span from the scintillator section.
Bars 50 x 20 mm, 2000 mm long; the short pair are the ESA25 quads, 1000 mm long.
0.5 mm aluminum covers at the CAD cover centers, none on the short pair.
The air envelope is local to this station; it does not span the tracker or ECal.
-->
  <define/>
  <solids>
    <box name="hcal_above_ecal_envelope" lunit="mm" x="2002.689" y="2002.689" z="94.750732"/>
    <box name="hcal_above_ecal_scint_box_x" lunit="mm" x="2000" y="50" z="20"/>
    <box name="hcal_above_ecal_scint_box_y" lunit="mm" x="50" y="2000" z="20"/>
    <box name="hcal_above_ecal_cover_1" lunit="mm" x="2000" y="400" z="0.5"/>
    <box name="hcal_above_ecal_cover_2" lunit="mm" x="400" y="2000" z="0.5"/>
    <box name="hcal_above_ecal_cover_3" lunit="mm" x="2000" y="400" z="0.5"/>
    <box name="hcal_above_ecal_cover_4" lunit="mm" x="400" y="2000" z="0.5"/>
  </solids>
  <structure>
    <!--Packed copy number: version 1 in bits 24-31, section in 16-23, layer in 8-15, strip in 0-7. Layers count from the top; strips start at zero on the -x (-y) side.-->
    <volume name="hcal_above_ecal_scint_box_x_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="hcal_above_ecal_scint_box_x"/>
      <auxiliary auxtype="VisAttributes" auxvalue="ScintillatorMaterialVis"/>
    </volume>
    <volume name="hcal_above_ecal_scint_box_y_volume">
      <materialref ref="Scintillator"/>
      <solidref ref="hcal_above_ecal_scint_box_y"/>
      <auxiliary auxtype="VisAttributes" auxvalue="ScintillatorMaterialVis"/>
    </volume>
    <volume name="hcal_above_ecal_cover_1_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="hcal_above_ecal_cover_1"/>
    </volume>
    <volume name="hcal_above_ecal_cover_2_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="hcal_above_ecal_cover_2"/>
    </volume>
    <volume name="hcal_above_ecal_cover_3_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="hcal_above_ecal_cover_3"/>
    </volume>
    <volume name="hcal_above_ecal_cover_4_volume">
      <materialref ref="Aluminum3003"/>
      <solidref ref="hcal_above_ecal_cover_4"/>
    </volume>
    <volume name="hcal_above_ecal">
      <materialref ref="Air"/>
      <solidref ref="hcal_above_ecal_envelope"/>
      <!--Layer 1: center Z=2824.467242 mm, bars along x, 8 x 2000 mm.-->
